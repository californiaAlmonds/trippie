# Optional. Without any source the app runs on simulated demo fares.

# Travelpayouts cached fares (thin for niche routes like Port Blair)
# https://app.travelpayouts.com/profile/api-token
TRAVELPAYOUTS_TOKEN=

# Hosted fare store shared by the scraper (GitHub Actions) and the web app.
# Leave empty to use the local file data/trippie.db.
# turso db create trippie ; turso db show trippie --url ; turso db tokens create trippie
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Canonical origin used for CSRF Origin validation, cookie security (__Host-), and email links.
# Example: https://trippie.example.com (defaults to the incoming request origin when unset).
APP_ORIGIN=

# SMTP configuration for account verification and password reset emails.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Local development only: set to 1 to auto-verify new accounts and sign in immediately when SMTP is not configured.
# NEVER enable in production.
ALLOW_UNVERIFIED_DEV=
